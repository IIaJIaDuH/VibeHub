# VibeHub Environment Configuration
#
# Важно: все переменные с префиксом VITE_ попадают в клиентский бандл.
# Никогда не указывайте здесь API-ключи и другие секреты.

# OpenRouter API URL (defaults to public models endpoint)
VITE_OPENROUTER_API_URL=https://openrouter.ai/api/v1

# Supabase (anon key публичен, service_role запрещён в client)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
